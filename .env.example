# PostgreSQL connection string. See docker-compose.yml.
DATABASE_URL=postgres://trado:trado@127.0.0.1:5432/trado

# Sealed session cookie secret. Must be at least 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NUXT_SESSION_PASSWORD=replace-with-a-random-string-at-least-32-characters

# Apply Drizzle migrations on server startup when the migrations folder is present.
# In production you can leave this false and run `npm run db:migrate` before start.
NUXT_AUTO_MIGRATE=true
